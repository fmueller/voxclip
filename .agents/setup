#!/usr/bin/env bash
set -euo pipefail

step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '==> %s\n' "$label"
  "$@"
  printf '    completed in %ss\n' "$((SECONDS - started))"
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mise_bin="$HOME/.local/bin/mise"
mise_version="2026.9.0"

missing_packages=()
for package in bats build-essential ca-certificates cmake curl ffmpeg file git; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fqx 'install ok installed'; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]})); then
  step "Refresh apt metadata" sudo apt-get update -qq
  step "Install system packages: ${missing_packages[*]}" \
    sudo apt-get install -y -qq --no-install-recommends "${missing_packages[@]}"
fi

mkdir -p "$(dirname "$mise_bin")"
installed_mise_version=""
if [[ -x "$mise_bin" ]]; then
  installed_mise_version="$($mise_bin --version | awk '{print $1}')"
fi
if [[ "$installed_mise_version" != "$mise_version" ]]; then
  printf '==> Install mise %s\n' "$mise_version"
  curl -fsSL https://mise.run | MISE_VERSION="v$mise_version" MISE_INSTALL_PATH="$mise_bin" sh
fi

export PATH="$HOME/.local/bin:$PATH"
cd "$repo_root"

step "Install pinned toolchain" "$mise_bin" install --yes
eval "$("$mise_bin" env -s bash)"

step "Download application modules" go mod download
step "Download website modules" go -C website mod download
step "Install Git hooks" task hooks:install

profile_marker="# voxclip mise environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >>"$HOME/.bash_profile" <<EOF

$profile_marker
if [[ \${PWD:-} == "$repo_root" && -z \${VOXCLIP_MISE_ACTIVE:-} ]]; then
  export VOXCLIP_MISE_ACTIVE=1
  eval "\$("$mise_bin" env -s bash)"
fi
EOF
fi

printf 'Orb setup complete in %ss.\n' "$SECONDS"
